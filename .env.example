# RationGuard configuration TEMPLATE.
# Do NOT put real keys here. Run:  python scripts/setup_keys.py
# That script creates a private `.env` (git-ignored) with fresh random keys.

# Three separate HMAC keys (64 hex characters = 32 random bytes each).
# Separate keys mean that leaking one does not break the other protections.
RG_TX_HMAC_KEY=REPLACE_ME_run_setup_keys
RG_AUDIT_HMAC_KEY=REPLACE_ME_run_setup_keys
RG_RECORD_HMAC_KEY=REPLACE_ME_run_setup_keys

# Fernet key that encrypts household name / address / phone at rest.
RG_FERNET_KEY=REPLACE_ME_run_setup_keys

# Secret used to derive CSRF tokens.
RG_SESSION_SECRET=REPLACE_ME_run_setup_keys

# Password given to the fictional demo users created by `seed`.
RG_SEED_PASSWORD=REPLACE_ME_run_setup_keys

# Where things live (all of these paths are git-ignored).
RG_DB_PATH=rationguard.db
RG_ANCHOR_FILE=anchors/anchors.jsonl
RG_SIGNING_PRIVATE_KEY=keys/anchor_ed25519_private.pem
RG_SIGNING_PUBLIC_KEY=keys/anchor_ed25519_public.pem

# Write a signed anchor after this many new audit entries (1 = every entry).
RG_ANCHOR_EVERY=5

# Set to true when serving over HTTPS so the cookie is never sent over HTTP.
RG_COOKIE_SECURE=false

# Business hours (local time) used by the off-hours alert.
RG_BUSINESS_START_HOUR=6
RG_BUSINESS_END_HOUR=22
RG_TZ_OFFSET_MINUTES=330
